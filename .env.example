# Copia este archivo a `.env` si prefieres autenticar los agentes por API key
# en lugar de hacer login interactivo dentro del contenedor.
# Todas las variables son opcionales.

# UID/GID del host (evita problemas de permisos en Linux; en macOS puede omitirse)
UID=1000
GID=1000
TZ=America/Mexico_City

# Claves de API — se pasan al contenedor como variables de entorno y no se
# escriben en disco (autenticación efímera).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
